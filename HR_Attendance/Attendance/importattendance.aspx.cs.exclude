        ddlMachineNo.Items.Insert(0, "Select");
    }

    protected void ddlMachineNo_TextChanged(object sender, EventArgs e)
    {
        checkMachineNo();
    }

    protected void checkMachineNo()
    {
        ADIEnt = new HR_Attendance_Attendance_Device_Info();
        if (ddlMachineNo.SelectedValue != "Select")
        {
            ADIEnt.PK_ID = ddlMachineNo.SelectedValue;
            ADIEnt = (HR_Attendance_Attendance_Device_Info();)ADISer.GetSingle(ADIEnt);
            if (ADIEnt != null)
            {
                txtDeviceIP.Text = ADIEnt.IP_ADDRESS;
            }
            else
            {
                HelperFunction.MsgBox(this, this.GetType(), "Machine not found !!");
                cleaField();
            }
        }
        else
        {
            HelperFunction.MsgBox(this, this.GetType(), "Please select the Machine No !!");
            cleaField();
        }
    }

    protected void cleaField()
    {
        ddlMachineNo.SelectedValue = "Select";
        txtDeviceIP.Text = "";
    }
