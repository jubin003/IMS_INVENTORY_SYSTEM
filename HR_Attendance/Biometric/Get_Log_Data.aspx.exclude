<%@ Page Title="" Language="C#" MasterPageFile="~/MasterPage.master" AutoEventWireup="true" CodeFile="Get_Log_Data.aspx.cs" Inherits="HR_Attendance_Biometric_Get_Log_Data" %>

<asp:Content ID="Content1" ContentPlaceHolderID="ContentPlaceHolder1" runat="Server">
    <script type="text/javascript">

        function myFunction() {
            var x = document.getElementById("divProgress");
            if (x.style.display === "none") {
                x.style.display = "block";
            } else {
                x.style.display = "none";
            }
        }
    </script>
    <style>
        .grid-style {
            border-collapse: collapse;
            width: 100%;
            table-layout: auto; /* Allows cells to resize based on content */
        }

            .grid-style th, .grid-style td {
                white-space: nowrap; /* Prevent column wrapping */
                padding: 8px;
                border: 1px solid #ddd;
                text-align: left;
            }

        .grid-header {
            background-color: #f2f2f2;
            font-weight: bold;
        }

        .grid-row {
            background-color: #ffffff;
        }
    </style>
    <div class="Container-fluid" style="font-size: 16px; font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif">
        <table id="divmain" runat="server">
            <tr style="overflow: visible">
                <td style="width: 200px">
                    <asp:Label ID="lblDeviceIP" runat="server" Text="Device IP"></asp:Label>
                    <asp:TextBox ID="txtDeviceIP" runat="server" CssClass="form-control"></asp:TextBox>
                </td>
                <td>
                    <asp:Label ID="lblPort" runat="server" Text="Port"></asp:Label>
                    <asp:TextBox ID="txtPort" runat="server" CssClass="form-control"></asp:TextBox>
                </td>
                <td style="width: 150px">
                    <asp:Label ID="lblMachineNo" runat="server" Text="Machine Number"></asp:Label>
                    <asp:TextBox ID="txtMachineNo" runat="server" CssClass="form-control"></asp:TextBox>
                </td>
                <td>
                    <br />
                    <asp:Button ID="btnLogData" runat="server" CssClass="btn btn-default" Text="Get Log Data" OnClientClick="myFunction()" OnClick="btnLogData_Click" />
                </td>
            </tr>
        </table>
        <div style="width: 100%; border: 1px solid grey; margin-top: 10px"></div>
        <table id="divDeviceInfo" style="width: 100%">
            <tr>
                <td style="margin: 10px">Device Info :-
                        <asp:Label ID="lblDeviceInfo" runat="server"></asp:Label>
                </td>
            </tr>
            <tr>
                <td id="divProgress" runat="server" visible="false">
                    <div style="position: absolute; top: 75%; left: 50%; margin-top: -50px; margin-left: -50px;">
                        Please wait import in process<br />
                        <img id="imgProgress" runat="server" visible="true" alt="Loading" src="~/images/icons/progress.gif" />
                    </div>
                </td>
            </tr>
            <tr>
                <td style="border: 1px solid grey; margin-top: 5px; width: 100%; max-height: 900px; overflow: auto; margin-bottom: 5em">
                    <asp:GridView ID="dgvRecords" runat="server" AutoGenerateColumns="true" CssClass="grid-style" Visible="false" Width="100%" Height="100%"
                        HeaderStyle-CssClass="grid-header" RowStyle-CssClass="grid-row" AllowPaging="false">
                    </asp:GridView>
                </td>
            </tr>
            <tr>
                <td>
                    <br />
                    <asp:Label ID="lblStatus" runat="server"></asp:Label>
                </td>
            </tr>
        </table>
    </div>
    <script>
        function resizeGrid() {
            const grid = document.getElementById('<%= dgvRecords.ClientID %>');
            const container = grid.parentElement;

            // Calculate available space
            const availableHeight = window.innerHeight - container.getBoundingClientRect().top - 20;

            // Set container height
            container.style.maxHeight = `${Math.min(availableHeight, 500)}px`;

            // Optional: force full width
            container.style.width = '100%';
            grid.style.width = '100%';
        }

        window.addEventListener('load', resizeGrid);
        window.addEventListener('resize', resizeGrid);
    </script>

</asp:Content>

