                                        <asp:Label ID="lblCNDiscountPercent" runat="server" Text=""></asp:Label>
                                        %</td>
                                    <td style="border-top: 1px solid black; text-align: right; padding-right: 5px">
                                        <asp:Label ID="lblCNDiscountAmount" runat="server"></asp:Label>
                                    </td>
                                </tr>
                                <tr>
