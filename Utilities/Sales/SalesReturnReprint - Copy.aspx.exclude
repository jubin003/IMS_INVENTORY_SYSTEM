                        <td style="text-align: right; border-bottom: 1px solid black; padding-right: 1px; border-right: 1px solid black; border-left: 1px solid black;">
                            <asp:Label ID="lblTotal20" runat="server"></asp:Label>&nbsp;</td>
                    </tr>
                </table>
                <table style="width: 100%; font-size: 12pt; border-collapse: collapse; border-top: 1px solid black;">
