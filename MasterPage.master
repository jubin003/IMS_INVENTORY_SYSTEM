<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>IMS</title>

    <link rel="icon" href="assets/images/logo.png" type="image/x-icon" />

    <%-- Dropdown & Table CSS --%>
    <link href="~/ajax/libs/js/chosen.min.css" rel="stylesheet" />
    <link href="~/css/fresh-bootstrap-table.css" rel="stylesheet" />
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/print.min.css" media="print" />
    <link href="~/css/Custom-cs.css" rel="stylesheet" />
    <link href="~/css/sidebar.css" rel="stylesheet" />
    <link href="~/css/hmsPage.css" rel="stylesheet" />
    <link href="~/css/ims-base.css" rel="stylesheet" />
    <link href="~/css/ims-form.css" rel="stylesheet" />
    <link href="~/css/ims-popup.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-modal/2.2.6/css/bootstrap-modal.min.css" />

    <link href="~/css/animate.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" />
    <link rel="stylesheet" href="~/css/weather-icons.css" />
    <link href="css/print.min.css" rel="stylesheet" />

    <%-- Scripts --%>
    <script src="<%= ResolveUrl("~/ajax/libs/js/jquery.min.js") %>"></script>
    <script src="<%= ResolveUrl("~/ajax/libs/js/bootstrap.min.js") %>"></script>
    <script type="text/javascript" src="<%= ResolveClientUrl("~/ajax/libs/js/chosen.jquery.js") %>"></script>
    <script type="text/javascript" src="<%= ResolveUrl("~/js/hmsLogics.js") %>"></script>

    <%-- Footer Clock Script --%>
    <script type="text/javascript">
        function updateTime() {
            var now = new Date();
            var hours = now.getHours();
            var minutes = now.getMinutes();
            var ampm = hours >= 12 ? 'PM' : 'AM';

            hours = hours % 12;
            hours = hours ? hours : 12;
            minutes = minutes < 10 ? '0' + minutes : minutes;

            var elHours = document.getElementById('lblHours');
            var elMinutes = document.getElementById('lblMinutes');
            var elColon = document.getElementById('lblColon');
            var elAMPM = document.getElementById('lblAMPM');

            if (elHours) elHours.innerText = hours;
            if (elMinutes) elMinutes.innerText = minutes;
            if (elColon) elColon.classList.toggle('blink');
            if (elAMPM) elAMPM.innerText = ampm;
        }

        function startClock() {
            updateTime();
            setInterval(updateTime, 60000);
        }

        window.onload = function () {
            startClock();
        };
    </script>

    <style>
        @keyframes blink {
            0% { opacity: 1; }
            50% { opacity: 0; }
            100% { opacity: 1; }
        }

        .blink {
            animation: blink 1s step-start infinite;
        }

        #lblTime {
            font-family: 'Arial', sans-serif;
            font-size: 12px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <script src="<%= ResolveUrl("~/js/dataTable.min.js") %>"></script>

    <!-- Top edge detector: slides down topnav when mouse approaches the top edge of screen -->
    <div id="topEdgeSensor" class="top-edge-sensor"></div>

    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" EnablePageMethods="true" runat="server"></asp:ScriptManager>

        <%-- ============================================================ --%>
        <%-- TOP NAVBAR: Width Left to Right (Logo Left, Settings Right)   --%>
        <%-- ============================================================ --%>
        <header id="hmsTopNav" class="hms-topnav">
            <!-- Left Corner: Logo -->
            <div class="topnav-left">
                <a href="<%= ResolveUrl("~/Default.aspx") %>" class="topnav-brand">
                    <asp:Image ID="Image1" runat="server" ImageUrl="~/images/topbar_logo.png" />
                </a>
            </div>

            <!-- Right Corner: Settings Panel -->
            <div class="topnav-right">
                <div class="topnav-settings">
                    <asp:HyperLink ID="HyperLink34" runat="server" NavigateUrl="javascript:void(0);" CssClass="topnav-settings-toggle">
                        <asp:Image ID="imgprofile" runat="server" CssClass="topnav-avatar" />
                        <span class="sidebar-icon"><i class="fa fa-cog"></i></span>
                        <span>Settings</span>
                        <i class="fa fa-angle-down"></i>
                    </asp:HyperLink>

                    <div class="topnav-settings-panel">
                        <div class="topnav-profile">
                            <asp:HyperLink ID="lblDisplayName" runat="server" NavigateUrl="" CssClass="topnav-profile-name"></asp:HyperLink>
                        </div>

                        <asp:HyperLink ID="HyperLink35" runat="server" NavigateUrl="~/PrivacySetting.aspx" CssClass="topnav-setting-link">
                            <i class="fa fa-lock"></i>
                            <span>Privacy Setting</span>
                        </asp:HyperLink>

                        <asp:HyperLink ID="HyperLink36" runat="server" NavigateUrl="ims.pdf" CssClass="topnav-setting-link" Target="_blank">
                            <i class="fa fa-question-circle"></i>
                            <span>Help</span>
                        </asp:HyperLink>

                        <asp:LinkButton ID="linkSignout" runat="server" OnClick="linkSignout_Click" CausesValidation="false" CssClass="topnav-setting-link topnav-signout">
                            <i class="fa fa-sign-out"></i>
                            <span>Sign Out</span>
                        </asp:LinkButton>
                    </div>
                </div>
            </div>
        </header>

        <%-- ============================================================ --%>
        <%-- SIDEBAR: Preserved original menu, sitting between TopNav & Footer --%>
        <%-- ============================================================ --%>
        <aside id="hmsSidebar" class="hms-sidebar">
            <div class="sidebar-header">
                <button type="button" id="sidebarCollapseBtn" class="sidebar-collapse-btn" onclick="toggleCollapsedSidebar()" aria-label="Collapse sidebar">
                    <i class="fa fa-chevron-left"></i>
                </button>
            </div>

            <div class="sidebar-menu">
                <a href="<%= ResolveUrl("~/Default.aspx") %>" class="sidebar-dashboard">
                    <span class="sidebar-icon"><i class="fa fa-dashboard"></i></span>
                    <span>Dashboard</span>
                </a>

                <asp:Repeater ID="repeaterModule" runat="server" OnItemDataBound="repeaterModule_ItemDataBound">
                    <ItemTemplate>
                        <div class="sidebar-module">
                            <asp:HyperLink ID="AdministrationModule" runat="server" NavigateUrl="javascript:void(0);" CssClass="sidebar-module-toggle">
                                <span class="sidebar-module-left">
                                    <span id="menuicon" runat="server" class="sidebar-icon"></span>
                                    <asp:Label ID="lblModuleName" CssClass="menuname" Text='<%# Bind("MODULENAME") %>' runat="server" />
                                    <asp:Label ID="lblModuleId" Text='<%# Bind("MODULEID") %>' runat="server" Visible="false" />
                                    <asp:Label ID="lblIcon" Text='<%# Bind("PICTURENAME") %>' runat="server" Visible="false" />
                                </span>
                                <span class="sidebar-arrow"><i class="fa fa-angle-right"></i></span>
                            </asp:HyperLink>

                            <div class="sidebar-submodules">
                                <asp:Repeater ID="repeaterSubModule" runat="server" OnItemDataBound="repeaterSubModule_ItemDataBound">
                                    <ItemTemplate>
                                        <div class="sidebar-submodule">
                                            <a href="javascript:void(0);" class="sidebar-submodule-toggle">
                                                <span>
                                                    <asp:Label ID="lblSubModuleName" Text='<%# Bind("submodule_name") %>' runat="server" />
                                                </span>
                                                <span class="sidebar-arrow"><i class="fa fa-angle-right"></i></span>
                                            </a>

                                            <asp:Label ID="lblSubModuleId" Text='<%# Bind("submoduleid") %>' runat="server" Visible="false" />
                                            <asp:Label ID="lblParentModuleId" Text='<%# Bind("moduleid") %>' runat="server" Visible="false" />

                                            <div class="sidebar-pages">
                                                <asp:Repeater ID="repeaterPages" runat="server">
                                                    <ItemTemplate>
                                                        <asp:HyperLink ID="HyperLink1" runat="server" NavigateUrl='<%# Bind("PAGENAME") %>' CssClass="sidebar-page-link">
                                                            <span class="page-dot">• </span>
                                                            <asp:Label ID="lblPagename" Text='<%# Bind("LINKNAME") %>' runat="server" />
                                                        </asp:HyperLink>
                                                    </ItemTemplate>
                                                </asp:Repeater>
                                            </div>
                                        </div>
                                    </ItemTemplate>
                                </asp:Repeater>
                            </div>
                        </div>
                    </ItemTemplate>
                </asp:Repeater>
            </div>
        </aside>

        <%-- ============================================================ --%>
        <%-- MAIN PAGE CONTENT                                            --%>
        <%-- ============================================================ --%>
        <div class="main-page">
            <div class="mb-40">
                <div class="col-md-offset-9 col-md-3 custom-breadcrumb no-padding-right pull-right" runat="server" id="breadcrumb" visible="false">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><asp:Label Text="" runat="server" ID="lblModule" /></li>
                        <li class="breadcrumb-item"><asp:Label Text="" runat="server" ID="lblSubModule" /></li>
                        <li class="breadcrumb-item"><asp:Label ID="lblPage" Text="" runat="server" /></li>
                    </ol>
                </div>
            </div>

            <div class="container-fluid">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>
    </form>

    <%-- ============================================================ --%>
    <%-- ORIGINAL FOOTER (Preserved HTML & Colors, Full Screen Width)  --%>
    <%-- ============================================================ --%>
    <footer class="footer-pos">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-4">
                    <asp:Label ID="lblComapanyName" runat="server"></asp:Label>
                </div>
                <div class="col-md-4" style="text-align: center">
                    <p class="font-12">Copyright © 2024 &nbsp;&nbsp;|&nbsp;&nbsp; Phye Gan Pvt. Ltd. &nbsp;&nbsp;| &nbsp;&nbsp; Version-V1.0</p>
                </div>
                <div class="col-md-4" style="text-align: right">
                    <asp:Label ID="lblNepaliDate" runat="server" Text=""></asp:Label>
                    <asp:Label ID="lblDate" runat="server" Text=""></asp:Label>
                    <asp:Label ID="lblTime" runat="server" Text="">
                        <span id="lblHours">Hour</span>
                        <span id="lblColon">:</span>
                        <span id="lblMinutes">Minutes</span>
                        <span id="lblAMPM">AM/PM</span>
                    </asp:Label>
                </div>
            </div>
        </div>
        <div class="scroll-top-wrapper">
            <span class="scroll-top-inner">
                <i class="fa fa-chevron-up"></i>
            </span>
        </div>
    </footer>

    <%-- Plugins & Datepicker Scripts --%>
    <script src="<%= ResolveUrl("~/js/jquery-ui.js") %>"></script>
    <link href="<%= ResolveUrl("~/assets/css/nepali.datepicker.v5.0.6.min.css") %>" rel="stylesheet" />
    <script src="<%= ResolveUrl("~/assets/js/nepali.datepicker.v5.0.6.min.js") %>"></script>
    <script src="<%= ResolveUrl("~/js/bootstrap-datepicker.js") %>"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('.datepicker').NepaliDatePicker({
                dateFormat: "DD/MM/YYYY", miniEnglishDates: true
            });

            $('.datepicker1').nepaliDatePicker({
                dateFormat: "DD/MM/YYYY", miniEnglishDates: true
            });

            $('.bdatepicker').datepicker({
                minViewMode: 2,
                format: 'yyyy'
            });

            $('.expiyDate').datepicker({
                dateFormat: "dd/mm/yy"
            });

            $('[data-toggle="tooltip"]').tooltip();

            $(document).on('scroll', function () {
                if ($(window).scrollTop() > 100) {
                    $('.scroll-top-wrapper').addClass('show');
                } else {
                    $('.scroll-top-wrapper').removeClass('show');
                }
            });

            $('.scroll-top-wrapper').on('click', scrollToTop);

            function scrollToTop() {
                var verticalOffset = typeof (verticalOffset) != 'undefined' ? verticalOffset : 0;
                var element = $('body');
                var offset = element.offset();
                var offsetTop = offset.top;
                $('html, body').animate({ scrollTop: offsetTop }, 500, 'linear');
            }
        });
    </script>

    <%-- Sidebar & TopNav Interactive Script --%>
    <script type="text/javascript">
        $(document).ready(function () {
            // Restore sidebar state
            var sidebarCollapsed = localStorage.getItem("hmsSidebarCollapsed") === "true";
            if (sidebarCollapsed) {
                $("#hmsSidebar").addClass("sidebar-collapsed");
                $("body").addClass("sidebar-is-collapsed");
            }
            updateSidebarCollapseButton(sidebarCollapsed);

            // Active route highlight
            setActiveSidebarPage();

            // Temporary hover expand
            $("#hmsSidebar .sidebar-menu").on("mouseenter", function () {
                var sidebar = $("#hmsSidebar");
                if (sidebar.hasClass("sidebar-collapsed")) {
                    sidebar.addClass("sidebar-hover-open");
                }
            });

            $("#hmsSidebar").on("mouseleave", function () {
                $(this).removeClass("sidebar-hover-open");
            });

            // Module dropdown toggle
            $(document).on("click", ".sidebar-module-toggle", function (e) {
                e.preventDefault();
                if ($("#hmsSidebar").hasClass("sidebar-collapsed") && !$("#hmsSidebar").hasClass("sidebar-hover-open")) {
                    return;
                }
                var currentModule = $(this).closest(".sidebar-module");
                $(".sidebar-module").not(currentModule).removeClass("sidebar-open");
                $(".sidebar-module").not(currentModule).find(".sidebar-submodule").removeClass("submenu-open");
                currentModule.toggleClass("sidebar-open");
            });

            // Submodule dropdown toggle
            $(document).on("click", ".sidebar-submodule-toggle", function (e) {
                e.preventDefault();
                e.stopPropagation();
                if ($("#hmsSidebar").hasClass("sidebar-collapsed") && !$("#hmsSidebar").hasClass("sidebar-hover-open")) {
                    return;
                }
                var currentSubModule = $(this).closest(".sidebar-submodule");
                var parentModule = currentSubModule.closest(".sidebar-module");
                parentModule.find(".sidebar-submodule").not(currentSubModule).removeClass("submenu-open");
                currentSubModule.toggleClass("submenu-open");
            });

            // Topbar settings dropdown toggle
            $(document).on("click", ".topnav-settings-toggle", function (e) {
                e.preventDefault();
                e.stopPropagation();
                $(".topnav-settings").toggleClass("settings-open");
            });

            $(document).on("click", ".topnav-settings-panel", function (e) {
                e.stopPropagation();
            });

            $(document).on("click", function () {
                $(".topnav-settings").removeClass("settings-open");
            });

            // Topbar scroll handling: Auto-hide scrolling down, show scrolling up
            var lastScrollTop = 0;
            $(window).on("scroll", function () {
                var currentScroll = $(this).scrollTop();

                if ($(".topnav-settings").hasClass("settings-open")) {
                    return;
                }

                if (currentScroll > 60 && currentScroll > lastScrollTop) {
                    $("#hmsTopNav").addClass("topnav-hidden");
                    $("body").addClass("topnav-is-hidden");
                } else if (currentScroll < lastScrollTop) {
                    $("#hmsTopNav").removeClass("topnav-hidden");
                    $("body").removeClass("topnav-is-hidden");
                }

                if (currentScroll <= 15) {
                    $("#hmsTopNav").removeClass("topnav-hidden");
                    $("body").removeClass("topnav-is-hidden");
                }

                lastScrollTop = currentScroll;
            });

            // Top screen edge sensor: Show navbar when mouse hovers within 15px of top
            $(document).on("mousemove", function (e) {
                if (e.clientY <= 15) {
                    $("#hmsTopNav").removeClass("topnav-hidden");
                    $("body").removeClass("topnav-is-hidden");
                }
            });

            $("#topEdgeSensor").on("mouseenter", function () {
                $("#hmsTopNav").removeClass("topnav-hidden");
                $("body").removeClass("topnav-is-hidden");
            });

            $("#hmsTopNav").on("mouseleave", function () {
                if ($(window).scrollTop() > 60 && !$(".topnav-settings").hasClass("settings-open")) {
                    $("#hmsTopNav").addClass("topnav-hidden");
                    $("body").addClass("topnav-is-hidden");
                }
            });
        });

        function toggleCollapsedSidebar() {
            var sidebar = $("#hmsSidebar");
            sidebar.toggleClass("sidebar-collapsed");
            var collapsed = sidebar.hasClass("sidebar-collapsed");
            $("body").toggleClass("sidebar-is-collapsed", collapsed);
            updateSidebarCollapseButton(collapsed);
            localStorage.setItem("hmsSidebarCollapsed", collapsed ? "true" : "false");
        }

        function updateSidebarCollapseButton(collapsed) {
            var button = $("#sidebarCollapseBtn");
            if (collapsed) {
                button.html('<i class="fa fa-chevron-right"></i>');
                button.attr("aria-label", "Expand sidebar");
            } else {
                button.html('<i class="fa fa-chevron-left"></i>');
                button.attr("aria-label", "Collapse sidebar");
            }
        }

        function setActiveSidebarPage() {
            var currentPath = window.location.pathname.toLowerCase().replace(/\/$/, "");
            $(".sidebar-page-link").each(function () {
                var linkPath = new URL(this.href, window.location.origin).pathname.toLowerCase().replace(/\/$/, "");
                if (linkPath === currentPath) {
                    $(this).addClass("active-page");
                    $(this).closest(".sidebar-submodule").addClass("submenu-open");
                    $(this).closest(".sidebar-module").addClass("sidebar-open");
                }
            });
        }

        function toggleSidebar() {
            $("#hmsSidebar").toggleClass("mobile-open");
        }
    </script>
</body>
</html>